<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Closing soon: <%= params.itemName %></title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#000;font-family:'Inter',sans-serif;color:#fff;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#000;margin:0;padding:0;width:100%;">
      <tr>
        <td>
          <div style="max-width:100%;margin:0 auto;padding:40px 20px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:40px;">
              <tr>
                <td align="center">
                  <img src="https://cardcades3prod.s3.us-east-1.amazonaws.com/cardcade-machine-wordmark.png" alt="CardCade Logo" width="280" style="display:block;width:280px;height:auto;" />
                </td>
              </tr>
            </table>
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:30px;">
              <tr>
                <td align="center">
                  <h1 style="font-size:28px;font-weight:700;color:#bdff00;margin:0;font-family:'Inter',sans-serif;">
                    Closing soon — last call to bid
                  </h1>
                </td>
              </tr>
            </table>
            <div style="background-color:#181818;border-radius:16px;border:1px solid #2c2c2c;padding:40px;max-width:700px;width:100%;box-sizing:border-box;margin:0 auto;">
              <div style="max-width:700px;margin:0 auto;color:#fff;">
                <p style="font-size:18px;line-height:1.6;margin-bottom:10px;opacity:0.7;text-transform:capitalize;color:#fff;">Hi <%= params.userName %>,</p>
                <p style="font-size:18px;line-height:1.6;margin-bottom:24px;opacity:0.7;color:#fff;">
                  The auction for <strong style="color:#fff"><%= params.itemName %></strong>
                  closes in about an hour. Any bid in the final 30 seconds will extend the auction by 30 seconds.
                </p>
                <div style="background-color:#222;border-left:4px solid #bdff00;padding:16px 20px;margin:0 0 28px 0;border-radius:8px;">
                  <p style="margin:8px 0;font-size:16px;color:#fff;">
                    <span style="font-weight:600;">Current bid:</span>
                    <span style="opacity:0.8;color:#bdff00;"><%= params.currentBid %></span>
                  </p>
                  <p style="margin:8px 0;font-size:16px;color:#fff;">
                    <span style="font-weight:600;">Closes:</span>
                    <span style="opacity:0.8;"><%= params.endsAt %></span>
                  </p>
                </div>
                <a href="<%= params.auctionUrl %>" style="padding:14px 24px;font-size:15px;background-color:#bdff00;color:#000;font-weight:600;text-decoration:none;border-radius:8px;max-width:300px;margin:auto;margin-top:20px;margin-bottom:20px;display:block;text-align:center;">
                  View the auction
                </a>
              </div>
            </div>
            <div style="margin-top:60px;font-size:14px;text-align:center;color:#fff;">© CardCade 2026</div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
