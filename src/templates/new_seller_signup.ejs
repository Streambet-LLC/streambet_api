<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New seller signup on CardCade</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #000000;
      font-family: 'Inter', sans-serif;
      color: #ffffff;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #000000; margin: 0; padding: 0; width: 100%"
    >
      <tr>
        <td>
          <div style="max-width: 100%; margin: 0 auto; padding: 40px 20px">
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 60px"
            >
              <tr>
                <td align="center">
                  <img
                    src="https://cardcades3prod.s3.us-east-1.amazonaws.com/cardcade-machine-wordmark.png"
                    alt="CardCade Logo"
                    width="280"
                    style="display: block; width: 280px; height: auto"
                  />
                </td>
              </tr>
            </table>

            <div
              style="
                background-color: #181818;
                border-radius: 16px;
                border: 1px solid #2c2c2c;
                padding: 40px;
                max-width: 700px;
                width: 100%;
                box-sizing: border-box;
                margin: 0 auto;
              "
            >
              <div style="max-width: 700px; margin: 0 auto; color: #ffffff">
                <p
                  style="
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 10px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  Heads up, team —
                </p>
                <p
                  style="
                    font-size: 22px;
                    line-height: 1.4;
                    margin-bottom: 24px;
                    font-family: 'Inter', sans-serif;
                    color: #bdff00;
                    font-weight: 700;
                  "
                >
                  A new seller just signed up on CardCade 🎉
                </p>

                <table
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    width: 100%;
                    margin-bottom: 24px;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  <tr>
                    <td style="padding: 8px 0; opacity: 0.7; width: 140px">
                      Username
                    </td>
                    <td style="padding: 8px 0; font-weight: 600">
                      <%= params.username %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 8px 0; opacity: 0.7">Email</td>
                    <td style="padding: 8px 0; font-weight: 600">
                      <%= params.email %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 8px 0; opacity: 0.7">Shop name</td>
                    <td style="padding: 8px 0; font-weight: 600">
                      <%= params.shopName %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 8px 0; opacity: 0.7">Signed up</td>
                    <td style="padding: 8px 0; font-weight: 600">
                      <%= params.signupDate %>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    font-size: 16px;
                    line-height: 1.6;
                    margin-bottom: 16px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  They've completed the seller questionnaire. Stripe Connect
                  onboarding may still be pending — keep an eye on the admin
                  dashboard if you need to follow up.
                </p>

                <a
                  href="<%= params.shopLink %>"
                  style="
                    padding: 14px 24px;
                    font-size: 15px;
                    background-color: #bdff00;
                    color: #000;
                    font-weight: 600;
                    text-decoration: none;
                    border-radius: 8px;
                    max-width: 300px;
                    margin: auto;
                    margin-top: 30px !important;
                    margin-bottom: 16px !important;
                    display: block;
                    text-align: center;
                    font-family: 'Inter', sans-serif;
                  "
                >
                  View Shop
                </a>
                <a
                  href="<%= params.adminUserLink %>"
                  style="
                    padding: 12px 24px;
                    font-size: 14px;
                    background-color: transparent;
                    color: #bdff00;
                    font-weight: 600;
                    text-decoration: none;
                    border: 1px solid #bdff00;
                    border-radius: 8px;
                    max-width: 300px;
                    margin: auto;
                    margin-bottom: 30px !important;
                    display: block;
                    text-align: center;
                    font-family: 'Inter', sans-serif;
                  "
                >
                  Open in Admin
                </a>

                <p
                  style="
                    margin-top: 15px;
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 0;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  <br /><b style="font-size: 20px">The CardCade Bot</b>
                </p>
              </div>
            </div>

            <div
              style="
                margin-top: 60px;
                font-size: 14px;
                text-align: center;
                color: #ffffff;
                font-family: 'Inter', sans-serif;
              "
            >
              © CardCade 2026
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
