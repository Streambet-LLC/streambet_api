<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Price <%= params.direction %>: <%= params.itemName %></title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #000000;
      font-family: 'Inter', sans-serif;
      color: #ffffff;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #000000; margin: 0; padding: 0; width: 100%"
    >
      <tr>
        <td>
          <div style="max-width: 100%; margin: 0 auto; padding: 40px 20px">
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 40px"
            >
              <tr>
                <td align="center">
                  <img
                    src="https://cardcades3prod.s3.us-east-1.amazonaws.com/cardcade-machine-wordmark.png"
                    alt="CardCade Logo"
                    width="280"
                    style="display: block; width: 280px; height: auto"
                  />
                </td>
              </tr>
            </table>

            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 30px"
            >
              <tr>
                <td align="center">
                  <h1
                    style="
                      font-size: 28px;
                      font-weight: 700;
                      color: #bdff00;
                      margin: 0;
                      font-family: 'Inter', sans-serif;
                    "
                  >
                    Price <%= params.direction %> on an item you're watching
                  </h1>
                </td>
              </tr>
            </table>

            <div
              style="
                background-color: #181818;
                border-radius: 16px;
                border: 1px solid #2c2c2c;
                padding: 40px;
                max-width: 700px;
                width: 100%;
                box-sizing: border-box;
                margin: 0 auto;
              "
            >
              <div style="max-width: 700px; margin: 0 auto; color: #ffffff">
                <p
                  style="
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 10px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    text-transform: capitalize;
                    color: #ffffff;
                  "
                >
                  Hi <%= params.userName %>,
                </p>
                <p
                  style="
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 24px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  The price of <strong style="color: #ffffff"
                    ><%= params.itemName %></strong
                  >
                  has <%= params.direction %>.
                </p>

                <div
                  style="
                    background-color: #222222;
                    border-left: 4px solid #bdff00;
                    padding: 16px 20px;
                    margin: 0 0 28px 0;
                    border-radius: 8px;
                  "
                >
                  <p style="margin: 8px 0; font-size: 16px; color: #ffffff">
                    <span style="font-weight: 600">Was:</span>
                    <span style="opacity: 0.8"><%= params.previousAmount %></span>
                  </p>
                  <p style="margin: 8px 0; font-size: 16px; color: #ffffff">
                    <span style="font-weight: 600">Now:</span>
                    <span style="opacity: 0.8; color: #bdff00"
                      ><%= params.newAmount %></span
                    >
                  </p>
                </div>

                <a
                  href="<%= params.itemUrl %>"
                  style="
                    padding: 14px 24px;
                    font-size: 15px;
                    background-color: #bdff00;
                    color: #000;
                    font-weight: 600;
                    text-decoration: none;
                    border-radius: 8px;
                    max-width: 300px;
                    margin: auto;
                    margin-top: 20px !important;
                    margin-bottom: 20px !important;
                    display: block;
                    text-align: center;
                  "
                  >View Item</a
                >

                <p
                  style="
                    margin-top: 24px;
                    font-size: 14px;
                    line-height: 1.6;
                    opacity: 0.5;
                    color: #ffffff;
                  "
                >
                  You're receiving this because you added this item to your
                  watchlist. You can unfollow it from your watchlist page at any
                  time.
                </p>
              </div>
            </div>

            <div
              style="
                margin-top: 60px;
                font-size: 14px;
                text-align: center;
                color: #ffffff;
              "
            >
              © CardCade 2026
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
