<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Message on CardCade</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #000000;
      font-family: 'Inter', sans-serif;
      color: #ffffff;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #000000; margin: 0; padding: 0; width: 100%"
    >
      <tr>
        <td>
          <div
            class="container"
            style="max-width: 100%; margin: 0 auto; padding: 40px 20px"
          >
            <!-- Logo -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 40px"
            >
              <tr>
                <td align="center">
                  <img
                    src="https://cardcades3prod.s3.us-east-1.amazonaws.com/cardcade-machine-wordmark.png"
                    alt="CardCade Logo"
                    width="280"
                    style="display: block; width: 280px; height: auto"
                  />
                </td>
              </tr>
            </table>

            <!-- Main Content -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="
                max-width: 600px;
                margin: 0 auto;
                background-color: #161616;
                border-radius: 16px;
                padding: 40px;
              "
            >
              <tr>
                <td>
                  <h1
                    style="
                      font-size: 24px;
                      font-weight: 700;
                      margin: 0 0 16px 0;
                      color: #ffffff;
                    "
                  >
                    You have a new message! 💬
                  </h1>

                  <p
                    style="
                      font-size: 16px;
                      line-height: 1.5;
                      color: #a0a0a0;
                      margin: 0 0 24px 0;
                    "
                  >
                    Hey <%= recipientName %>,
                  </p>

                  <p
                    style="
                      font-size: 16px;
                      line-height: 1.5;
                      color: #a0a0a0;
                      margin: 0 0 24px 0;
                    "
                  >
                    <strong style="color: #ffffff"><%= senderName %></strong> sent you a message:
                  </p>

                  <!-- Message Preview -->
                  <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                      background-color: #222222;
                      border-radius: 12px;
                      padding: 20px;
                      margin: 0 0 32px 0;
                    "
                  >
                    <tr>
                      <td
                        style="
                          padding: 20px;
                          font-size: 14px;
                          line-height: 1.6;
                          color: #d0d0d0;
                          font-style: italic;
                        "
                      >
                        "<%= messagePreview %>"
                      </td>
                    </tr>
                  </table>

                  <!-- CTA Button -->
                  <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="margin: 0 0 24px 0"
                  >
                    <tr>
                      <td align="center">
                        <a
                          href="<%= conversationLink %>"
                          style="
                            display: inline-block;
                            background: linear-gradient(135deg, #9b87f5, #7c3aed);
                            color: #ffffff;
                            text-decoration: none;
                            padding: 14px 40px;
                            border-radius: 12px;
                            font-size: 16px;
                            font-weight: 600;
                          "
                        >
                          Reply in App
                        </a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- Footer -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="max-width: 600px; margin: 32px auto 0"
            >
              <tr>
                <td
                  align="center"
                  style="font-size: 12px; color: #666666; line-height: 1.5"
                >
                  <p style="margin: 0">
                    You're receiving this because you have email notifications enabled on CardCade.
                  </p>
                  <p style="margin: 8px 0 0 0">
                    &copy; <%= new Date().getFullYear() %> CardCade. All rights reserved.
                  </p>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
