{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "subject": { "type": "string" },
    "params": {
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "itemName": { "type": "string" },
        "currentBid": { "type": "string" },
        "endsAt": { "type": "string" },
        "auctionUrl": { "type": "string" }
      },
      "required": ["userName", "itemName", "currentBid", "endsAt", "auctionUrl"]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
