{
  "id": "http://streambet.com/email-standard-schema#",
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "required": ["username", "shopManageLink"],
      "properties": {
        "username": {
          "type": "string",
          "description": "Username of the seller getting auctions enabled"
        },
        "shopManageLink": {
          "type": "string",
          "description": "Link to the seller shop manage page"
        }
      }
    }
  },
  "required": ["params"]
}
