{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "Recipient email addresses"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "params": {
      "type": "object",
      "properties": {
        "sellerName": {
          "type": "string",
          "description": "Name of the seller"
        },
        "itemName": {
          "type": "string",
          "description": "Name of the purchased item"
        },
        "buyerName": {
          "type": "string",
          "description": "Name of the buyer"
        },
        "amount": {
          "type": "number",
          "description": "Purchase amount in USD"
        },
        "orderId": {
          "type": "string",
          "description": "Order ID"
        },
        "purchaseDate": {
          "type": "string",
          "description": "Date of purchase"
        },
        "buyerFullName": {
          "type": "string",
          "description": "Full name of the buyer for shipping"
        },
        "shippingAddressLine1": {
          "type": "string",
          "description": "Shipping address line 1"
        },
        "shippingAddressLine2": {
          "type": "string",
          "description": "Shipping address line 2 (optional)"
        },
        "shippingCity": {
          "type": "string",
          "description": "Shipping city"
        },
        "shippingState": {
          "type": "string",
          "description": "Shipping state/province"
        },
        "shippingZipCode": {
          "type": "string",
          "description": "Shipping ZIP/postal code"
        },
        "shippingCountry": {
          "type": "string",
          "description": "Shipping country"
        },
        "markShippedUrl": {
          "type": "string",
          "description": "URL to the seller dashboard to mark the order as shipped"
        }
      },
      "required": [
        "sellerName",
        "itemName",
        "buyerName",
        "amount",
        "orderId",
        "purchaseDate"
      ]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
