<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leave a review for your buyer ⭐</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #000000;
      font-family: 'Inter', sans-serif;
      color: #ffffff;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #000000; margin: 0; padding: 0; width: 100%"
    >
      <tr>
        <td>
          <div style="max-width: 100%; margin: 0 auto; padding: 40px 20px">
            <!-- Logo -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 40px"
            >
              <tr>
                <td align="center">
                  <img
                    src="https://cardcades3prod.s3.us-east-1.amazonaws.com/cardcade-machine-wordmark.png"
                    alt="CardCade Logo"
                    width="280"
                    style="display: block; width: 280px; height: auto"
                  />
                </td>
              </tr>
            </table>

            <!-- Heading -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 30px"
            >
              <tr>
                <td align="center">
                  <h1
                    style="
                      font-size: 28px;
                      font-weight: 700;
                      color: #bdff00;
                      margin: 0;
                      font-family: 'Inter', sans-serif;
                    "
                  >
                    ⭐ Rate your buyer
                  </h1>
                  <p
                    style="
                      font-size: 16px;
                      color: #ffffff;
                      opacity: 0.7;
                      margin-top: 8px;
                      font-family: 'Inter', sans-serif;
                    "
                  >
                    Leave a review for <%= params.buyerName %>
                  </p>
                </td>
              </tr>
            </table>

            <!-- Main Box -->
            <div
              style="
                background-color: #181818;
                border-radius: 16px;
                border: 1px solid #2c2c2c;
                padding: 40px;
                max-width: 700px;
                width: 100%;
                box-sizing: border-box;
                margin: 0 auto;
              "
            >
              <div style="max-width: 700px; margin: 0 auto; color: #ffffff">
                <p
                  style="
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 10px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    text-transform: capitalize;
                    color: #ffffff;
                  "
                >
                  Hi <%= params.sellerName %>,
                </p>
                <p
                  style="
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 24px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  Thanks for selling on CardCade. Take a moment to leave a
                  review for your buyer — it helps the community know who's a
                  great person to deal with.
                </p>

                <!-- Order Details -->
                <div
                  style="
                    background-color: #222222;
                    border-left: 4px solid #bdff00;
                    padding: 16px 20px;
                    margin: 0 0 28px 0;
                    border-radius: 8px;
                  "
                >
                  <p
                    style="
                      margin: 8px 0;
                      font-size: 16px;
                      font-family: 'Inter', sans-serif;
                      color: #ffffff;
                    "
                  >
                    <span style="font-weight: 600; color: #ffffff">Item:</span>
                    <span style="opacity: 0.8"><%= params.itemName %></span>
                  </p>
                  <p
                    style="
                      margin: 8px 0;
                      font-size: 16px;
                      font-family: 'Inter', sans-serif;
                      color: #ffffff;
                    "
                  >
                    <span style="font-weight: 600; color: #ffffff">Buyer:</span>
                    <span style="opacity: 0.8"><%= params.buyerName %></span>
                  </p>
                  <p
                    style="
                      margin: 8px 0;
                      font-size: 16px;
                      font-family: 'Inter', sans-serif;
                      color: #ffffff;
                    "
                  >
                    <span style="font-weight: 600; color: #ffffff"
                      >Order ID:</span
                    >
                    <span style="opacity: 0.8"><%= params.orderId %></span>
                  </p>
                  <p
                    style="
                      margin: 8px 0;
                      font-size: 16px;
                      font-family: 'Inter', sans-serif;
                      color: #ffffff;
                    "
                  >
                    <span style="font-weight: 600; color: #ffffff"
                      >Purchased:</span
                    >
                    <span style="opacity: 0.8"><%= params.purchaseDate %></span>
                  </p>
                </div>

                <!-- CTA Button -->
                <a
                  href="<%= params.reviewUrl %>"
                  style="
                    padding: 14px 24px;
                    font-size: 15px;
                    background-color: #bdff00;
                    color: #000;
                    font-weight: 600;
                    text-decoration: none;
                    border-radius: 8px;
                    max-width: 300px;
                    margin: auto;
                    margin-top: 20px !important;
                    margin-bottom: 20px !important;
                    display: block;
                    text-align: center;
                    font-family: 'Inter', sans-serif;
                  "
                  >Leave a Review</a
                >

                <p
                  style="
                    margin-top: 24px;
                    font-size: 14px;
                    line-height: 1.6;
                    margin-bottom: 30px;
                    opacity: 0.5;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  You can edit your review for 7 days and delete it for 14 days
                  after posting.
                </p>

                <p
                  style="
                    margin-top: 24px;
                    font-size: 18px;
                    line-height: 1.6;
                    margin-bottom: 30px;
                    opacity: 0.7;
                    font-family: 'Inter', sans-serif;
                    color: #ffffff;
                  "
                >
                  Cheers,<br /><b style="font-size: 20px">The CardCade Team</b>
                </p>
              </div>
            </div>

            <!-- Footer -->
            <div
              style="
                margin-top: 60px;
                font-size: 14px;
                text-align: center;
                color: #ffffff;
                font-family: 'Inter', sans-serif;
              "
            >
              © CardCade 2026
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
