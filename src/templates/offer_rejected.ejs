<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>❌ Update on Your Offer</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #000000;
      font-family: 'Inter', sans-serif;
      color: #ffffff;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #000000; margin: 0; padding: 0; width: 100%"
    >
      <tr>
        <td>
          <div
            class="container"
            style="max-width: 100%; margin: 0 auto; padding: 40px 20px"
          >
            <!-- Logo -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-bottom: 60px"
            >
              <tr>
                <td align="center">
                  <img
                    src="https://cardcades3prod.s3.us-east-1.amazonaws.com/cardcade-machine-wordmark.png"
                    alt="CardCade Logo"
                    width="280"
                    style="display: block; width: 280px; height: auto"
                  />
                </td>
              </tr>
            </table>

            <!-- Main Content -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="
                margin-bottom: 40px;
                background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 10px 40px rgba(252, 163, 17, 0.15);
              "
            >
              <tr>
                <td style="padding: 50px 30px; text-align: center">
                  <!-- Icon -->
                  <div style="margin-bottom: 30px">
                    <span style="font-size: 80px">💭</span>
                  </div>

                  <!-- Title -->
                  <h1
                    style="
                      margin: 0 0 20px 0;
                      font-size: 32px;
                      font-weight: 700;
                      color: #fca311;
                      letter-spacing: -0.5px;
                    "
                  >
                    Update on Your Offer
                  </h1>

                  <!-- Greeting -->
                  <p
                    style="
                      margin: 0 0 15px 0;
                      font-size: 18px;
                      line-height: 1.7;
                      color: #e5e5e5;
                    "
                  >
                    Hi <%= params.userName %>,
                  </p>

                  <!-- Message -->
                  <p
                    style="
                      margin: 0 0 30px 0;
                      font-size: 18px;
                      line-height: 1.7;
                      color: #e5e5e5;
                    "
                  >
                    Thank you for your interest in
                    <strong><%= params.prizeName %></strong>.
                  </p>

                  <p
                    style="
                      margin: 0 0 30px 0;
                      font-size: 16px;
                      line-height: 1.7;
                      color: #cccccc;
                    "
                  >
                    Unfortunately, we're unable to accept your offer of
                    <strong style="color: #fca311"
                      >$<%= parseFloat(params.offerAmount).toFixed(2) %></strong
                    >
                    at this time.
                  </p>

                  <!-- Offer Details Box -->
                  <div
                    style="
                      background: #000000;
                      border-radius: 15px;
                      padding: 25px;
                      margin: 30px 0;
                      text-align: left;
                      border: 2px solid #555555;
                    "
                  >
                    <table width="100%" cellpadding="12" cellspacing="0">
                      <tr>
                        <td style="color: #999999; font-size: 14px">Item:</td>
                        <td
                          style="
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 600;
                            text-align: right;
                          "
                        >
                          <%= params.prizeName %>
                        </td>
                      </tr>
                      <tr>
                        <td style="color: #999999; font-size: 14px">
                          Your Offer:
                        </td>
                        <td
                          style="
                            color: #888888;
                            font-size: 18px;
                            text-align: right;
                            text-decoration: line-through;
                          "
                        >
                          $<%= parseFloat(params.offerAmount).toFixed(2) %>
                        </td>
                      </tr>
                    </table>
                  </div>

                  <p
                    style="
                      margin: 30px 0 0 0;
                      font-size: 14px;
                      color: #888888;
                      line-height: 1.6;
                    "
                  >
                    You can still purchase this item at the listed price, or
                    browse other items in our collection.
                  </p>

                  <!-- CTA Button -->
                  <div style="margin-top: 35px">
                    <a
                      href="<%= params.prizesUrl %>"
                      style="
                        display: inline-block;
                        padding: 18px 50px;
                        background: linear-gradient(
                          135deg,
                          #fca311 0%,
                          #e89500 100%
                        );
                        color: #000000;
                        text-decoration: none;
                        font-weight: 600;
                        font-size: 18px;
                        border-radius: 50px;
                        box-shadow: 0 8px 25px rgba(252, 163, 17, 0.4);
                        transition: all 0.3s ease;
                      "
                      >Browse Items →</a
                    >
                  </div>
                </td>
              </tr>
            </table>

            <!-- Footer -->
            <table
              width="100%"
              cellpadding="0"
              cellspacing="0"
              border="0"
              style="margin-top: 40px"
            >
              <tr>
                <td align="center">
                  <p
                    style="
                      margin: 0 0 15px 0;
                      font-size: 14px;
                      color: #666666;
                      line-height: 1.6;
                    "
                  >
                    Need help? Visit our
                    <a
                      href="<%= params.supportUrl %>"
                      style="color: #fca311; text-decoration: none"
                      >Help Center</a
                    >
                  </p>
                  <p
                    style="
                      margin: 0;
                      font-size: 12px;
                      color: #555555;
                      line-height: 1.5;
                    "
                  >
                    © <%= new Date().getFullYear() %> CardCade. All rights
                    reserved.
                  </p>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
