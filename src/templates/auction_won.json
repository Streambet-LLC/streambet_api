{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "subject": { "type": "string" },
    "params": {
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "itemName": { "type": "string" },
        "winningBid": { "type": "string" },
        "buyerFee": { "type": "string" },
        "shippingFee": { "type": "string" },
        "totalCharged": { "type": "string" },
        "chargeStatus": { "type": "string" },
        "sellerName": { "type": "string" },
        "isSellerOwned": { "type": "boolean" },
        "orderUrl": { "type": "string" }
      },
      "required": ["userName", "itemName", "winningBid", "buyerFee", "shippingFee", "totalCharged", "chargeStatus", "sellerName", "isSellerOwned", "orderUrl"]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
