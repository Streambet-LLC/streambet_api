{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "Recipient email addresses"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "params": {
      "type": "object",
      "properties": {
        "buyerName": {
          "type": "string",
          "description": "Name of the buyer"
        },
        "itemName": {
          "type": "string",
          "description": "Name of the shipped item"
        },
        "orderId": {
          "type": "string",
          "description": "Order ID"
        },
        "trackingNumber": {
          "type": "string",
          "description": "Tracking number for the shipment"
        },
        "shippingCarrier": {
          "type": "string",
          "description": "Name of the shipping carrier (e.g., FedEx, UPS)"
        },
        "shippedDate": {
          "type": "string",
          "description": "Date the item was shipped"
        }
      },
      "required": ["buyerName", "itemName", "orderId", "shippedDate"]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
