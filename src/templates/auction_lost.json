{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "subject": { "type": "string" },
    "params": {
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "itemName": { "type": "string" },
        "winningBid": { "type": "string" },
        "shopUrl": { "type": "string" }
      },
      "required": ["userName", "itemName", "winningBid", "shopUrl"]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
