{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "subject": { "type": "string" },
    "params": {
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "heading": { "type": "string" },
        "userName": { "type": "string" },
        "intro": { "type": "string" },
        "itemName": { "type": "string" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["label", "value"]
          }
        },
        "ctaLabel": { "type": "string" },
        "ctaUrl": { "type": "string" },
        "footnote": { "type": "string" }
      },
      "required": ["logoUrl", "heading", "userName", "intro"]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
