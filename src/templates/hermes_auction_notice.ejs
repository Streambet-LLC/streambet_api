<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= params.heading %></title>
  </head>
  <body style="margin:0;padding:0;background-color:#0a0a0a;font-family:Inter,Helvetica,Arial,sans-serif;color:#ffffff;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#0a0a0a;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
            <tr>
              <td align="center" style="padding-bottom:28px;">
                <img src="<%= params.logoUrl %>" alt="Hermes Auctions" width="240" style="display:block;width:240px;height:auto;" />
              </td>
            </tr>
            <tr>
              <td style="background-color:#151515;border:1px solid #2a2a2a;border-radius:16px;padding:32px;">
                <h1 style="margin:0 0 16px 0;font-size:24px;line-height:1.3;color:#c6ff00;font-weight:800;"><%= params.heading %></h1>
                <p style="margin:0 0 8px 0;font-size:16px;line-height:1.6;color:#d4d4d4;">Hi <%= params.userName %>,</p>
                <p style="margin:0 0 24px 0;font-size:16px;line-height:1.6;color:#d4d4d4;"><%= params.intro %></p>
                <% if (params.itemName) { %>
                <p style="margin:0 0 12px 0;font-size:17px;font-weight:700;color:#ffffff;"><%= params.itemName %></p>
                <% } %>
                <% if (params.rows && params.rows.length) { %>
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#1e1e1e;border-left:4px solid #c6ff00;border-radius:8px;margin:0 0 24px 0;">
                  <% params.rows.forEach(function (row) { %>
                  <tr>
                    <td style="padding:10px 16px;font-size:15px;color:#a3a3a3;"><%= row.label %></td>
                    <td align="right" style="padding:10px 16px;font-size:15px;font-weight:600;color:#ffffff;"><%= row.value %></td>
                  </tr>
                  <% }); %>
                </table>
                <% } %>
                <% if (params.ctaUrl) { %>
                <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:8px auto 8px auto;">
                  <tr>
                    <td style="background-color:#c6ff00;border-radius:10px;">
                      <a href="<%= params.ctaUrl %>" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:700;color:#000000;text-decoration:none;"><%= params.ctaLabel %></a>
                    </td>
                  </tr>
                </table>
                <% } %>
                <% if (params.footnote) { %>
                <p style="margin:24px 0 0 0;font-size:13px;line-height:1.6;color:#8a8a8a;"><%= params.footnote %></p>
                <% } %>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding-top:24px;font-size:12px;color:#6b6b6b;">
                Hermes Auctions · Zero-seller-fee collectibles auctions
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
