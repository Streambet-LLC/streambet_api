{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "subject": { "type": "string" },
    "params": {
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "itemName": { "type": "string" },
        "previousAmount": { "type": "string" },
        "newAmount": { "type": "string" },
        "direction": { "type": "string" },
        "itemUrl": { "type": "string" }
      },
      "required": [
        "userName",
        "itemName",
        "previousAmount",
        "newAmount",
        "direction",
        "itemUrl"
      ]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
