{
  "id": "http://streambet.com/email-standard-schema#",
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "toAddress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subject": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "properties": {
        "userName": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "prizeName": {
          "type": "string"
        },
        "acceptedAmount": {
          "type": "number"
        },
        "checkoutUrl": {
          "type": "string"
        },
        "supportUrl": {
          "type": "string"
        }
      },
      "required": [
        "userName",
        "orderId",
        "prizeName",
        "acceptedAmount",
        "checkoutUrl",
        "supportUrl"
      ]
    }
  },
  "required": ["toAddress", "subject", "params"]
}
